{
  "_version": "2.11.0",
  "sap.app": {
    "id": "tp.example",
    "type": "application",
    "title": "OpenUI5 Test Project",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
        "desktop": true,
        "tablet": false,
        "phone": false
    }
  },
  "sap.ui5": {
    "dependencies": {
        "minUI5Version": "1.15.0",
        "libs": {
            "sap.m": {
                "minVersion": "1.34.0"
            },
            "sap.ui.commons": {
                "minVersion": "1.34.0",
                "lazy": true
            }
        },
        "components": {
            "sap.ui.app.other": {
                "minVersion": "1.1.0",
                "lazy": true
            }
        }
    },
    "contentDensities": {
        "compact": false,
        "cozy": true
    },
    "rootView": {
      "viewName": "tp.example.view.App",
      "type": "XML",
      "id": "app"
    },
    "models": {
      "test": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/data.json"
      },
      "order": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/order.json"
      }
    },
    "routing" : {
        "config" : {
          "routerClass" : "sap.m.routing.Router",
          "type" : "View",
          "viewType" : "XML",
          "path" : "tp.example.view",
          "controlId" : "app",
          "controlAggregation" : "pages"
        },
        "routes" : [
            {
                "pattern" : "",
                "name": "home",
                "target": "home"
            },
            {
              "pattern" : "restaurant/{restaurantPath}",
              "name" : "restaurant",
              "target" : "restaurant"
            }
        ],
        "targets" : {
          "home" : {
              "id" : "home",
              "name" : "Home"
          },
          "restaurant" : {
              "id" : "restaurant",
              "name" : "Restaurant"
          }
        }
    }
  }
}