<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    displayBlock="true"
    controllerName="tp.example.controller.App">
    <Page title="Home Page">
            <core:Fragment fragmentName="tp.example.view.CartButton" type="XML"/>
            <Button text="Search" width="10%" press=".onButtonPress" />
            <MultiInput id="multiInput" width="90%" tokenUpdate=".onTokenUpdate"/>
            <List
                id="list"
                items="{test>/Restaurants}" >
                <StandardListItem
                    title="{test>RestaurantName}"
                    description="{test>OwnerName}"
                    type="Navigation"
                    press=".onPress"/>
            </List>
    </Page>


</mvc:View>