<core:FragmentDefinition 
    xmlns:form="sap.ui.layout.form"
	xmlns="sap.m"
    core:require="{formatter: 'tp/example/model/formatter'}"
	xmlns:core="sap.ui.core"> 
    <Dialog id="CartDialog" title="{order>Restaurant/RestaurantName}">  
        <List
        noDataText="No Products Found"
        mode="Delete" 
        delete=".onDeleteItem"
        items="{
            path: 'order>/Dishes'
        }">
        <items>
            <ObjectListItem
                title="{order>Name}"
                number="{= ${order>Price}/100}"
                numberUnit="EUR"
                type="Active">
            </ObjectListItem>
        </items>
        </List>
    <Panel >
        <Text text="Total Cost: {= ${formatter: 'formatter.totalSum', path: 'order>/Dishes'}/100} EUR"></Text>
        <Button text="Checkout" press=".onButtonCheckout"></Button>
    </Panel>

    
    
    </Dialog>  
</core:FragmentDefinition>