<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    core:require="{formatter: 'tp/example/model/formatter'}"
    xmlns:layout="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    displayBlock="true"
    controllerName="tp.example.controller.Checkout">
    <Page title="Checkout" binding="{order>/}"
    showNavButton="true"
    navButtonPress=".onNavBack">
            <List
                items="{order>/Dishes}" 
                mode="Delete" 
                delete=".onDeleteItem">
                <ObjectListItem
                    title="{order>Name}"
                    number="{= ${order>Price}/100}"
                    numberUnit="EUR"
                    type="Active"
                    press=".onPress">
                    <ObjectAttribute text="{order>Category}" />
                    <ObjectAttribute text="{formatter: 'formatter.numItems', parts : [{path: 'order>/Dishes'}, {path: 'order>Name'}]}" />
                    </ObjectListItem>
            </List>
            <List >
                <ObjectListItem
                    title="Total"
                    number="{= ${formatter: 'formatter.totalSum', path: 'order>/Dishes'}/100}"
                    numberUnit="EUR"
                    type="Active"
                    press=".onPress">
                    <ObjectAttribute text="{= ${order>Dishes}.length} items" /> 
                    </ObjectListItem>
            </List>
    <f:SimpleForm editable="true" layout="ResponsiveGridLayout" title="Lieferadresse">
        <f:content>
                <Label text="Straße und Hausnummer" required="true"></Label>
                <Input
                    placeholder="Enter Adress" value="{order>Adress/Street}"/>
                <Label text="PLZ" required="true"></Label>
                <Input
                    placeholder="Enter Zipcode" value="{order>Adress/PostCode}"/>
                <Label text="Stadt" required="true"></Label>
                <Input
                    placeholder="Enter City" value="{order>Adress/City}"/>
                <Label text="Land" required="true"></Label>
                <Input
                    placeholder="Enter Country" value="{order>Adress/Country}"/>
        </f:content>
    </f:SimpleForm>


    <f:SimpleForm editable="true" layout="ResponsiveGridLayout" title="Bezahlmethode">
        <f:content>
            <Label text="Payment Method" required="true"></Label>
                <ComboBox
                    items="{
                        path: 'order>PaymentOptions',
                        sorter: { path: 'order>text' }
                    }"
                    value="{order>PaymentMethod}">
                    <core:Item key="{order>key}" text="{order>text}" />
                </ComboBox>
                <Label text="Email" required="true"></Label>
                <Input 
                    placeholder="Enter Email"/>
                <Label text="Passwort" required="true"></Label>
                <Input
                    type="Password"
                    placeholder="Enter password" />
                <Button text="Confirm Purchase" 
                enabled="{= ${order>Adress/Street} !== null &amp;&amp; ${order>Adress/PostCode} !== null &amp;&amp; ${order>Adress/City} !== null &amp;&amp; ${order>Adress/Country} !== null }" 
                press=".onConfirmPurchase"></Button>
        </f:content>
    </f:SimpleForm>
    </Page>
</mvc:View>