<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true"
    controller="tp.example.controller.App">
    <Shell>
        <App>
        <pages>
            <Page title="Home Page">
                <content>
                <Panel headerText="Test Panel">
                <content>
                    <Text text="{test>/Test}"/>
                    <Button text="Search" press=".onButtonPress"></Button>
                    <List 
                        id="categories"
                        items="{test>/Categories}">
                        <StandardListItem 
                            title="{test>Category}">
                        </StandardListItem>
                        </List>
                    <List
                        id="list"
                        items="{test>/Restaurants}" >
                        <StandardListItem
                            title="{test>RestaurantName}"
                            description="{test>OwnerName}"/>
                    </List>
                </content>
                </Panel>
                </content>
            </Page>
        </pages>
        </App>
    </Shell>


</mvc:View>