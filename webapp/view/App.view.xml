<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true"
    controllerName="tp.example.controller.App">
    <Shell>
        <App id="app">
            <Page title="Home Page">
                <Panel headerText="Test Panel">
                    <Button text="Search" press=".onButtonPress" />
                    <MultiInput id="multiInput" width="100%"/>
                    <List
                        id="list"
                        items="{test>/Restaurants}" >
                        <StandardListItem
                            title="{test>RestaurantName}"
                            description="{test>OwnerName}"/>
                    </List>
                </Panel>
            </Page>
        </App>
    </Shell>


</mvc:View>