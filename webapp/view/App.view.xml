<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true"
    controller="tp.example.controller.App">
        <App id="app">
            <Page title="Home Page">
                <Panel headerText="Test Panel">
                    <Text text="{test>/Test}"/>
                    <Button text="Search" press=".onButtonPress" />
                    <List 
                        id="categories"
                        items="{test>/Categories}">
                        <StandardListItem 
                            title="{test>Category}">
                        </StandardListItem>
                        </List>
                    <List
                        id="list"
                        items="{test>/Restaurants}" >
                        <StandardListItem
                            title="{test>RestaurantName}"
                            description="{test>OwnerName}"/>
                    </List>
                </Panel>
            </Page>
        </App>
   


</mvc:View>